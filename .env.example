NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ERP_URL=https://pdcar-erp-history.onrender.com
NEXT_PUBLIC_SHOP_PHONE=0840079122
# Opens the verified public OA profile only; it does not prefill or send a message.
NEXT_PUBLIC_LINE_URL=https://line.me/R/ti/p/%40pdcar
SITE_ENV=preview
SITE_ANALYTICS_ENABLED=false
SITE_ADMIN_ENABLED=false
ADMIN_SITE_URL=https://www.pdcarcenter.com
# Random salt and SHA-256 digest, formatted as base64url-salt:base64url-hash.
ADMIN_PASSWORD_HASH=
# At least 32 random characters. Rotating it signs out all admin sessions.
ADMIN_SESSION_SECRET=

# Article approval only. Leave disabled until staging checks and production approval.
ARTICLE_APPROVAL_ENABLED=false
# Keep false until the Cloudflare scheduler, database and delivery checks pass.
ARTICLE_DAILY_CRON_ENABLED=false
ARTICLE_SITE_URL=https://www.pdcarcenter.com
# Dedicated PostgreSQL LOGIN, member of pdcar_article_worker; never use ERP/postgres/service_role.
ARTICLE_DATABASE_URL=
# Base64 PEM of the official Supabase CA (public certificate, not a private key).
ARTICLE_DATABASE_CA_BASE64=
CRON_SECRET=
OPENAI_API_KEY=
# Choose a Responses API model supporting strict structured outputs.
ARTICLE_OPENAI_MODEL=
ARTICLE_LINE_CHANNEL_ACCESS_TOKEN=
ARTICLE_LINE_ADMIN_IDS=
ARTICLE_LIFF_ID=
ARTICLE_LINE_LOGIN_CHANNEL_ID=
# Keep false: LIFF is the default, preserving the existing OA webhook.
ARTICLE_LINE_POSTBACK_ENABLED=false
# Only needed for an explicitly approved, pre-existing raw-body webhook relay:
ARTICLE_LINE_CHANNEL_SECRET=
ARTICLE_LINE_BOT_USER_ID=
