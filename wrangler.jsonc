{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdcar-website",
  "workers_dev": true,
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "www.pdcarcenter.com", "custom_domain": true },
    { "pattern": "pdcarcenter.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "VEHICLE_IMAGES",
      "bucket_name": "pdcar-vehicle-images"
    }
  ],
  "hyperdrive": [
    {
      "binding": "ARTICLE_DATABASE_HYPERDRIVE",
      "id": "d8d38836e2d24f82b8da06eee2f956c2",
      "localConnectionString": "postgresql://local:local@127.0.0.1:5432/postgres"
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    "SITE_ENV": "production",
    "SITE_ANALYTICS_ENABLED": "true",
    "SITE_ADMIN_ENABLED": "true",
    "ADMIN_SITE_URL": "https://www.pdcarcenter.com",
    "ARTICLE_APPROVAL_ENABLED": "false",
    "ARTICLE_DAILY_CRON_ENABLED": "false",
    "ARTICLE_LINE_POSTBACK_ENABLED": "false"
  },
  // Worker Previews do not inherit production vars or bindings. Keep previews
  // read-only and tracking-free; intentionally omit R2 and Hyperdrive.
  "previews": {
    "vars": {
      "SITE_ENV": "preview",
      "SITE_ANALYTICS_ENABLED": "false",
      "SITE_ADMIN_ENABLED": "false",
      "ARTICLE_APPROVAL_ENABLED": "false",
      "ARTICLE_DAILY_CRON_ENABLED": "false",
      "ARTICLE_LINE_POSTBACK_ENABLED": "false",
      "VEHICLE_MEDIA_LEGACY_R2_FALLBACK_ENABLED": "false"
    }
  },
  // Add "0 12 * * *" only when article integrations have been verified.
  "triggers": { "crons": [] }
}
