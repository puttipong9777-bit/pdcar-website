{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdcar-website",
  "workers_dev": true,
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    { "pattern": "www.pdcarcenter.com", "custom_domain": true },
    { "pattern": "pdcarcenter.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "VEHICLE_IMAGES",
      "bucket_name": "pdcar-vehicle-images"
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    "SITE_ENV": "production",
    "SITE_ANALYTICS_ENABLED": "false",
    "SITE_ADMIN_ENABLED": "false",
    "ADMIN_SITE_URL": "https://www.pdcarcenter.com",
    "ARTICLE_APPROVAL_ENABLED": "false",
    "ARTICLE_DAILY_CRON_ENABLED": "false",
    "ARTICLE_LINE_POSTBACK_ENABLED": "false"
  },
  // Add "0 12 * * *" only when article integrations have been verified.
  "triggers": { "crons": [] }
}
